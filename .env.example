KOFI_FULFILL_SECRET=

# Your Payhip product page, e.g. https://payhip.com/b/xxxxx
PAYHIP_PRODUCT_URL=
PAYHIP_API_KEY=
# Optional: comma list of Payhip product_key / product_id / product_permalink values that
# unlock the guide. Unset = the key parsed from PAYHIP_PRODUCT_URL (https://payhip.com/b/<key>
# or https://payhip.com/buy?link=<key>); if neither gives a key, paid webhooks return 503.
PAYHIP_GUIDE_PRODUCT_KEYS=

BINANCE_USDT_ADDRESS_TRC20=
BINANCE_USDT_ADDRESS_BEP20=
BINANCE_USDT_ADDRESS_ERC20=
BINANCE_USDT_ADDRESS_TON=
# MEMO Binance requires for TON deposits (Binance > Deposit > USDT > TON shows it next to the
# address). Without it a customer's transfer is not credited. Shown with a copy button.
BINANCE_USDT_MEMO_TON=
BINANCE_USDT_ADDRESS=

GMAIL_USER=
GMAIL_APP_PASSWORD=

ADMIN_EMAIL=

BASE_URL=https://yourdomain.com

DB_PATH=purchases.db

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
